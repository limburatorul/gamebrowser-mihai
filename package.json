{
  "name": "game-browser",
  "version": "1.22.1",
  "private": true,
  "description": "A lightweight, standalone game library manager with manual and folder-scan import.",
  "main": "out/main/index.js",
  "author": "you",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:zip": "node scripts/test-zip.mjs",
    "dist": "electron-vite build && electron-builder --win portable"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.10.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.2.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  },
  "build": {
    "appId": "com.local.game-browser",
    "productName": "Game Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    }
  },
  "allowScripts": {}
}
